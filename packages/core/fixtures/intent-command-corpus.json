          "fileName": "회의.txt",
          "externalTransfer": true
        },
        "entities": {
          "mentionsExternalDestination": true
        }
      }
    },
    {
      "id": "a03-browser-search-security-log",
      "command": "jarvis 보안 로그 검색해",
      "expected": {
        "actionType": "BROWSER_SEARCH",
        "slots": {
          "query": "jarvis 보안 로그",
