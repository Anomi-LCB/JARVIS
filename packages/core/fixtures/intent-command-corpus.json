        "entities": {
          "mentionsExternalDestination": false
        }
      }
    },
    {
      "id": "a03-browser-search-dated-news",
      "command": "오늘 AI 에이전트 보안 뉴스 조사해줘",
      "expected": {
        "actionType": "BROWSER_SEARCH",
        "slots": {
          "query": "오늘 AI 에이전트 보안 뉴스",
          "dateHint": "오늘"
        },
        "entities": {
          "hasDate": true
        }
      }
    },
    {
      "id": "a03-delete-file",
      "command": "급여 파일 삭제해",
      "expected": {
        "actionType": "DELETE_FILE",
        "entities": {
          "mentionsExternalDestination": false
        }
      }
    },
    {
      "id": "a03-create-sensitive-phone",
      "command": "내일 010-1234-5678 연락처가 들어간 안내문 작성해",
      "expected": {
        "actionType": "CREATE_FILE",
        "slots": {
          "outputFormat": "txt",
          "dateHint": "내일"
        },
        "entities": {
          "hasPhoneNumber": true,
          "hasDate": true
        }
      }
    },
    {
      "id": "a03-create-sensitive-money",
      "command": "헌금 30만원 입금 내역 보고서 만들어",
      "expected": {
        "actionType": "CREATE_FILE",
        "slots": {
          "outputFormat": "txt",
          "fileName": "헌금-입금-내역.txt"
        },
        "entities": {
          "hasMoneyAmount": true,
          "mentionsExternalDestination": false
        }
      }
    },
    {
      "id": "a03-complex-search-then-create",
      "command": "다음 주 행사 일정 조사하고 보고서 만들어",
      "expected": {
        "actionType": "CREATE_FILE",
        "slots": {
          "outputFormat": "txt",
          "fileName": "행사-일정.txt",
          "dateHint": "다음 주"
        },
        "entities": {
          "hasDate": true
        },
        "complexity": {
          "needsPlanDecomposition": true
        }
      }
    },
    {
      "id": "a03-complex-create-and-upload",
      "command": "엑셀 보고서 만들고 그리고 밴드에 공유해",
      "expected": {
        "actionType": "UPLOAD_FILE",
        "slots": {
          "destination": "band",
          "externalTransfer": true
        },
        "entities": {
          "mentionsExternalDestination": true
        },
        "complexity": {
          "needsPlanDecomposition": true
        }
      }
    }
