{
  "policyVersion": "jarvis-e-policy-v1.2",
  "schemaVersion": "e-policy-schema-v1",
  "constitution": {
    "principles": [
      "deny_by_default",
      "no_execution_without_approval",
      "no_mobile_simple_approval_for_tier3_or_higher",
      "no_external_or_destructive_capability_in_mvp",
      "growth_memory_cannot_relax_policy",
      "external_content_is_not_a_command"
    ]
  },
  "risk": {
    "forbiddenActions": ["DELETE_FILE", "MAKE_PAYMENT", "CHANGE_SYSTEM_SETTING", "READ_SECRET"],
    "tiersByAction": {
      "CREATE_FILE": 5,
      "LIST_FILES": 5,
      "COPY_FILE": 5,
      "MOVE_FILE": 5,
      "BROWSER_SEARCH": 4,
      "DESKTOP_CONTROL": 3,
      "SEND_EMAIL": 2,
      "UPLOAD_FILE": 3,
      "DELETE_FILE": 2,
      "MAKE_PAYMENT": 1,
      "CHANGE_SYSTEM_SETTING": 1,
      "READ_SECRET": 1
    }
  },
  "dataRules": [
    {
      "id": "secret",
      "pattern": "(?:api[_ -]?key|access[_ -]?token|auth[_ -]?token|token|password|passwd|secret|비밀번호|토큰|비밀키)\\s*(?::|=|은|는)\\s*['\\\"]?[A-Z0-9_./+\\-]{6,}|(?<![A-Z0-9_])(?:sk|ghp|github_pat|xox[baprs]|AIza)[_\\-][A-Z0-9_\\-]{8,}|AKIA[A-Z0-9]{16}|Bearer\\s+[A-Z0-9_./+\\-]{12,}",
      "dataClass": "D4",
      "ministryDataClass": "M4",
      "flags": ["secret"]
    },
    {
      "id": "resident_registration_number",
      "pattern": "\\b\\d{6}[-\\s]?[1-4]\\d{6}\\b",
      "dataClass": "D4",
      "ministryDataClass": "M4",
      "flags": ["national_id", "pii"]
    },
    {
      "id": "financial_account",
      "pattern": "계좌|은행|입금|출금|헌금|십일조|account number|bank transfer",
      "dataClass": "D3",
      "ministryDataClass": "M4",
      "flags": ["financial", "ministry_finance"]
    },
    {
      "id": "email_address",
      "pattern": "[A-Z0-9._%+-]+@[A-Z0-9.-]+\\.[A-Z]{2,}",
      "dataClass": "D2",
      "ministryDataClass": "M2",
      "flags": ["email", "pii"]
    },
    {
      "id": "ministry_sensitive",
      "pattern": "상담|질병|가정사|재정|심방|기도제목|목양|새가족|교적|양육",
      "dataClass": "D3",
      "ministryDataClass": "M3",
      "flags": ["ministry_sensitive"]
    },
    {
      "id": "health_pastoral_care",
      "pattern": "우울|불안|질병|진단|복용|입원|치료|상처|중독|자살|medical|diagnosis|hospital",
      "dataClass": "D3",
      "ministryDataClass": "M4",
      "flags": ["health", "pastoral_care"]
    },
    {
      "id": "minor_or_family",
      "pattern": "아동|청소년|미성년|자녀|가정폭력|학대|양육권|minor|child custody",
      "dataClass": "D3",
      "ministryDataClass": "M4",
      "flags": ["minor", "family_sensitive"]
    },
    {
      "id": "phone_number",
      "pattern": "\\b010[-.\\s]?\\d{4}[-.\\s]?\\d{4}\\b",
      "dataClass": "D2",
      "ministryDataClass": "M2",
      "flags": ["phone_number"]
    }
  ],
  "approval": {
    "tiers": {
      "1": { "required": true, "approvalMode": "pc_only", "mobileApprovalAllowed": false, "expiresInSec": 0, "decision": "block" },
      "2": { "required": true, "approvalMode": "pc_only", "mobileApprovalAllowed": false, "expiresInSec": 180, "decision": "require_approval" },
      "3": { "required": true, "approvalMode": "pc_only", "mobileApprovalAllowed": false, "expiresInSec": 300, "decision": "require_approval" },
      "4": { "required": true, "approvalMode": "detailed", "mobileApprovalAllowed": false, "expiresInSec": 900, "decision": "require_approval" },
      "5": { "required": true, "approvalMode": "simple", "mobileApprovalAllowed": true, "expiresInSec": 1800, "decision": "require_approval" }
    },
    "mobileTier4Allowed": false
  },
  "capability": {
    "maxTtlMs": 3600000,
    "defaultAllowedPaths": ["./workspace"],
    "forbiddenIssueActions": ["DELETE_FILE", "UPLOAD_FILE", "MAKE_PAYMENT"],
    "maxAffectedItems": 20,
    "maxRuntimeMs": 30000
  },
  "toolPoisoning": {
    "toolOutputSources": ["TOOL_OUTPUT", "TOOL_METADATA", "WEB_CONTENT", "EMAIL_CONTENT", "PDF_CONTENT", "OCR_CONTENT"],
    "blockedInstructionPatterns": [
      "ignore previous",
      "이전 지시.*무시",
      "execute this",
      "run this command",
      "이 명령을 실행",
      "토큰.*업로드",
      "upload.*token",
      "로컬 파일.*읽",
      "read.*local file"
    ],
    "nonExecutableBoundary": "TOOL_OUTPUT_NON_EXECUTABLE"
  },
  "promptInjection": {
    "blockedPatterns": [
      { "id": "ignore_previous", "pattern": "ignore previous|이전 지시.*무시", "severity": "high", "scope": "all" },
      { "id": "instruction_override_synonyms", "pattern": "(?:disregard|forget|override|cancel)[\\s\\S]{0,40}(?:prior|previous|earlier|above)[\\s\\S]{0,40}(?:instruction|direction|rule|prompt)|(?:앞선|기존|이전|위의|모든)[\\s\\S]{0,30}(?:지시|명령|규칙)[\\s\\S]{0,30}(?:무시|취소|잊|덮어|따르지)", "severity": "high", "scope": "all" },
      { "id": "secret_exfiltration", "pattern": "(?:(?:upload|send|post|exfiltrate|leak|reveal|print|return|copy|steal|read|extract)[\\s\\S]{0,48}(?:token|api[_ -]?key|secret|password|credential))|(?:(?:token|api[_ -]?key|secret|password|credential)[\\s\\S]{0,48}(?:upload|send|post|exfiltrate|leak|reveal|print|return|copy|steal|read|extract))|(?:(?:토큰|비밀번호|비밀키|api[ _-]?키|자격 증명)[\\s\\S]{0,36}(?:업로드|전송|보내|노출|출력|읽|복사|탈취))|(?:(?:업로드|전송|보내|노출|출력|읽|복사|탈취)[\\s\\S]{0,36}(?:토큰|비밀번호|비밀키|api[ _-]?키|자격 증명))", "severity": "high", "scope": "untrusted_only" },
      { "id": "local_file_access", "pattern": "로컬 파일.*읽|read.*local file|C:[/\\\\]+Users|/etc/passwd", "severity": "high", "scope": "untrusted_only" },
      { "id": "policy_bypass", "pattern": "승인 없이|without approval|bypass policy|정책.*우회", "severity": "high", "scope": "all" },
      { "id": "system_prompt_probe", "pattern": "system prompt|시스템 프롬프트|developer message", "severity": "medium", "scope": "all" },
      { "id": "role_override", "pattern": "(?:^|[<\\[(\\s])(?:system|developer|assistant)[>\\]):\\s-]*(?:you are|act as|new instruction|override|disable)|<(?:system|developer|assistant)>[\\s\\S]{0,80}(?:disable|ignore|override|execute)", "severity": "high", "scope": "untrusted_only" },
      { "id": "safety_disable", "pattern": "(?:disable|remove|turn off|bypass|ignore)[\\s\\S]{0,40}(?:safety|security|guardrail|policy|approval|restriction)|(?:안전|보안|보호|승인|정책|제한)[\\s\\S]{0,30}(?:해제|비활성|우회|무시|끄기)", "severity": "high", "scope": "all" },
      { "id": "hidden_instruction_markup", "pattern": "\\[//\\]:\\s*#\\s*\\([^)]*(?:ignore|execute|override|bypass)|<!--[^>]*(?:ignore|execute|override|bypass)|<(?:system|developer|assistant)>", "severity": "high", "scope": "untrusted_only" }
    ],
    "quotedContentNonExecutable": true,
    "untrustedSourceTypes": ["WEB_CONTENT", "PDF_CONTENT", "EMAIL_CONTENT", "OCR_CONTENT", "CLIPBOARD_CONTENT", "TOOL_OUTPUT", "TOOL_METADATA"],
    "decisions": {
      "high": "block",
      "medium": "warn",
      "low": "allow"
    }
  },
  "autonomy": {
    "approvalCountAtLeast": 5,
    "failureCount": 0,
    "rejectionCount": 0,
    "expiresAtRequired": true,
    "minimumRiskTier": 4,
    "forbiddenScopeActions": ["DELETE_FILE"]
  }
}
