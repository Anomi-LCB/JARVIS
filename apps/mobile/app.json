{
  "expo": {
    "name": "JARVIS Mobile",
    "slug": "jarvis-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jarvis",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "자비스에게 말로 명령하기 위해 마이크를 사용합니다.",
          "speechRecognitionPermission": "말한 내용을 명령으로 바꾸기 위해 음성 인식을 사용합니다."
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "local.eureka.jarvis",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS",
        "USE_BIOMETRIC",
        "RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "local.eureka.jarvis",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "JARVIS sends local approval and execution status notifications.",
        "NSFaceIDUsageDescription": "JARVIS can use Face ID to unlock sensitive approval actions."
      }
    }
  }
}
